<?xml version="1.0" encoding="utf-8"?>
<!--
  墨水屏开关：轨道「关」= 白底黑框（空心）。
  与「开」的纯黑实心形成填充差，即使滑块位置看不出来也能区分状态。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/eink_paper" />
    <stroke
        android:width="2dp"
        android:color="@color/eink_ink" />
    <corners android:radius="12dp" />
    <size
        android:width="44dp"
        android:height="24dp" />
</shape>
