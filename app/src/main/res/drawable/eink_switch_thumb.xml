<?xml version="1.0" encoding="utf-8"?>
<!--
  墨水屏开关的滑块：纯黑圆点，**两种状态共用**（不做状态选择器）。

  - 关：空心轨道（白底 2dp 黑框）+ 左端黑点 → 一眼是「有个点停在左边」；
  - 开：纯黑实心轨道 + 右端黑点（与轨道同色，视觉上融成一根实心条）→ 一眼是「整条黑」。

  不做状态选择器的原因：换 drawable 之后 `drawableStateChanged()` 不会自动重放，
  「开」会把默认（黑）滑块画到黑轨道上，结果又是一团黑——这正是最初的现象。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/eink_ink" />
    <size
        android:width="18dp"
        android:height="18dp" />
</shape>
